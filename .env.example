# Use a renewable GitHub credential with organization runner-management access.
GH_TOKEN=replace-with-renewable-github-token

# Optional read-only GitHub token for <org>/spot-runners-config (falls back to GH_TOKEN).
SPOT_CONFIG_GH_TOKEN=

# Optional central runner configuration repository, owner/repo (defaults to <org>/spot-runners-config).
# With --manage-control-vm it also reaches each new control VM's dashboard as dashboard-config-repo metadata.
SPOT_CONFIG_REPO=

# Optional Cloud Billing Catalog API key for faster price discovery.
GOOGLE_CLOUD_API_KEY=

# Optional standard or detailed Cloud Billing usage export (all project costs).
GCP_BILLING_EXPORT_TABLE=

# Optional GitHub OAuth App login for the Web UI Dashboard (src/web_dashboard.py).
# The owner, GitHub user swackhamer (id 619624), may sign in, and so may the administrators the owner
# adds on the dashboard's Admins page (stored in dashboard state). Each must administer every controlled
# repository (DASHBOARD_CONTROLLED_TARGETS plus every repos/<owner>/<repo>.yaml in the config repository)
# unless global administrators are enabled. Sign-in uses the authorization-code flow with PKCE.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional: set to 1 to also offer GitHub Device Flow sign-in (off by default; the OAuth App must
# have Device Flow enabled).
GITHUB_OAUTH_DEVICE_FLOW=

# Optional OAuth scopes (space or comma separated; default: "repo read:org").
GITHUB_OAUTH_SCOPES=

# Absolute callback URL. Set it for any internet-facing deployment, for example
# https://spot.swacktech.com/auth/github/callback (default: derived from the request Host header).
GITHUB_OAUTH_REDIRECT_URI=

# Optional public origin accepted for same-origin POSTs behind the Cloudflare Worker, for example
# https://spot.swacktech.com (default: the origin of GITHUB_OAUTH_REDIRECT_URI).
DASHBOARD_PUBLIC_ORIGIN=

# Required when GITHUB_OAUTH_CLIENT_ID is set: random HMAC secret of at least 32 bytes.
# Share the same value with every dashboard VM and edge worker so sessions survive VM rotation.
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DASHBOARD_SESSION_SECRET=

# Optional session lifetime in seconds (60-604800; default: 43200).
DASHBOARD_SESSION_TTL_SECONDS=

# Optional bulk sign-out: Unix time; sessions issued before it are rejected (default: 0, none).
# Set it to the current time (date +%s) on every dashboard and as SESSION_NOT_BEFORE on the edge Worker.
# In the autoscaler environment it becomes the dashboard-session-not-before metadata of new control VMs.
# Sessions can't be revoked one at a time, and a lost GitHub admin permission takes effect at the next sign-in.
DASHBOARD_SESSION_NOT_BEFORE=

# Global administrators sign in without administrator permission on every controlled target.
# Entries are login:numeric_id, pinned to the GitHub user ID. Empty means the default swackhamer:619624,
# the only entry allowed; administrators added on the Admins page are then global administrators too.
# "none" disables, so everyone, added administrators included, must administer every target.
DASHBOARD_GLOBAL_ADMINS=

# Optional comma-separated orgs and owner/repo targets that OAuth users must administer (default: none).
# Targets saved through POST /api/auth/targets live in the --state-file and commit only after a fresh
# GitHub sign-in. If the state file exists but can't be read, GitHub sign-in fails closed (HTTP 500).
# With --manage-control-vm it also reaches each new control VM's dashboard as dashboard-controlled-targets
# metadata (;-separated there); a malformed entry stops control VM creation.
DASHBOARD_CONTROLLED_TARGETS=

# Optional runner hot-patch executor for the dashboard's Runner Patches tab. Leave empty on the control VM
# (it has no gcloud or SSH path to runner hosts; the action answers 501). Set to gcloud only where gcloud
# and operator credentials exist.
DASHBOARD_HOT_PATCH_EXECUTOR=

# Optional: set to gce to list runner hosts (and their recorded spot-runner-patch metadata) from Compute
# Engine for the Runner Patches preview. Control VMs set it; their service account needs compute.instances.list.
DASHBOARD_FLEET_INVENTORY=

# Control VM and Cloudflare edge (src/control_vm.py, src/spot_runner_autoscaler.py --manage-control-vm).
# Workers KV namespace that holds origin:active and the dashboard:state snapshot.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
# API token limited to Workers KV Storage edit on that account.
CLOUDFLARE_KV_API_TOKEN=

# Cloudflare Access service token that protects the spot-origin-<slot> tunnel hostnames.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Random secret of at least 32 bytes shared by the autoscaler and every control VM; signs
# freeze/snapshot/import control calls during make-before-break rotation.
DASHBOARD_CONTROL_SECRET=

# Optional: force the GCE metadata-server token instead of gcloud (set automatically on control VMs).
SPOT_GCP_TOKEN_SOURCE=

# Control VM provisioning: spot (default) picks the cheapest Spot shape under SPOT_CONTROL_MAX_DAILY_USD and
# rotates for price; standard runs the always-on free-tier e2-micro (one per billing account, us-central1,
# us-east1 or us-west1 only, 15 GB pd-standard boot disk). Standard needs a published dashboard image
# (SPOT_DASHBOARD_IMAGE digest, or SPOT_DASHBOARD_SOURCE_REF of a commit published as
# ghcr.io/swack-tools/spot-dashboard:<sha>) and every SPOT_CONTROL_REGIONS entry must be a free-tier region
# (default when unset: us-central1). Its external IPv4 address (about $0.005/hour) is not free. Every
# --manage-control-vm controller in the project must use the same value. See docs/edge-dashboard.md.
SPOT_CONTROL_PROVISIONING=spot
# Optional control VM placement and budget.
SPOT_CONTROL_REGIONS=us-central1,us-east1,us-west1
SPOT_CONTROL_MAX_DAILY_USD=0.50
# Set to 0 when the control VM's subnet has Cloud NAT.
SPOT_CONTROL_EXTERNAL_IP=1
SPOT_CONTROL_SERVICE_ACCOUNT=
SPOT_CONTROL_ORIGIN_DOMAIN=swacktech.com
# Optional directory of the project-wide control VM lock and state (control-vm-<project>.lock/.json) that every
# --manage-control-vm controller in the project shares (default: the autoscaler's default state directory).
SPOT_CONTROL_STATE_DIR=

# Dashboard image for control VMs: either a digest-pinned image (recommended; the Dashboard image workflow prints
# it), or a 40-hex commit to build on a Spot VM (the standard e2-micro pulls that commit's published tag instead).
SPOT_DASHBOARD_IMAGE=
SPOT_DASHBOARD_REPO=swack-tools/spot-github-runners
SPOT_DASHBOARD_SOURCE_REF=
# Public dashboard URL: https://host[:port], optionally with a trailing slash; a path, query, fragment, or
# user info stops control VM creation.
SPOT_DASHBOARD_PUBLIC_URL=https://spot.swacktech.com
SPOT_CLOUDFLARED_IMAGE=
