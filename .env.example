# Use a renewable GitHub credential with organization runner-management access.
GH_TOKEN=replace-with-renewable-github-token

# Optional read-only GitHub token for <org>/spot-runners-config (falls back to GH_TOKEN).
SPOT_CONFIG_GH_TOKEN=

# Optional central runner configuration repository (defaults to <org>/spot-runners-config).
SPOT_CONFIG_REPO=

# Optional Cloud Billing Catalog API key for faster price discovery.
GOOGLE_CLOUD_API_KEY=

# Optional standard or detailed Cloud Billing usage export (all project costs).
GCP_BILLING_EXPORT_TABLE=

# Optional GitHub OAuth login for the Web UI Dashboard (src/web_dashboard.py).
# Setting the client ID enables GitHub Device Flow sign-in (no client secret needed).
# Sign-in cookies use the __Host- prefix and the Secure attribute, so browsers store them only on
# HTTPS origins or http://localhost. Serve any other origin over HTTPS (TLS or a TLS-terminating proxy).
GITHUB_OAUTH_CLIENT_ID=

# Optional OAuth app client secret; also enables /auth/github/login -> /auth/github/callback (with PKCE S256).
GITHUB_OAUTH_CLIENT_SECRET=

# Optional OAuth scopes (space or comma separated; default: "repo read:org").
GITHUB_OAUTH_SCOPES=

# Absolute callback URL, for example https://spot.example.com/auth/github/callback.
# Required in production: when unset, the URL is derived from the request Host header (local development only).
GITHUB_OAUTH_REDIRECT_URI=

# Required when GITHUB_OAUTH_CLIENT_ID is set: random HMAC secret of at least 32 bytes.
# Share the same value with every dashboard VM and edge worker so sessions survive VM rotation.
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DASHBOARD_SESSION_SECRET=

# Optional session lifetime in seconds (60-604800; default: 43200).
DASHBOARD_SESSION_TTL_SECONDS=

# Optional bulk revocation: Unix time; sessions issued before it are rejected (default: 0, none).
# Set it to the current time (date +%s) on every dashboard VM and edge worker to sign everyone out.
# Sessions cannot be revoked individually, and a GitHub admin removal takes effect at the next sign-in.
DASHBOARD_SESSION_NOT_BEFORE=

# Optional comma-separated GitHub logins allowed to sign in (default: swackhamer,xbmc4lyfe).
DASHBOARD_ALLOWED_ADMINS=

# Optional comma-separated orgs and owner/repo targets that OAuth users must administer (default: none).
# Targets added through POST /api/auth/targets are stored in the --state-file; without a state file they
# are lost on restart. If the state file exists but cannot be parsed, GitHub sign-in fails closed (503)
# and the file is left untouched for repair. OAuth users confirm each change with a fresh GitHub sign-in.
DASHBOARD_CONTROLLED_TARGETS=
