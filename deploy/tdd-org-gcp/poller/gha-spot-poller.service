[Unit]
Description=Create throwaway GCP Spot runner VMs (large rust-heavy/bigmem, small gcp-rust) for queued jobs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=gha-spot-poller
Environment=GCP_PROJECT=email-rs-493900 GCP_ZONE=australia-southeast1-c GCP_INSTANCE=gha-spot-1
# Ephemeral mode: one throwaway VM per queued job, in two classes sharing the
# project's 32-vCPU quota: one large VM or up to four small ones (2026-10-18).
# Template names come from `terraform output runner_templates` (deploy/tdd-org-gcp).
Environment=MODE=ephemeral RUNNER_GROUP_ID=6 VCPU_QUOTA=32
Environment=LARGE_TEMPLATE=gha-large-20261018231626514000000002 LARGE_LABELS=rust-heavy,bigmem LARGE_VCPUS=30 LARGE_MAX=1
Environment=SMALL_TEMPLATE=gha-small-20261018231626512700000001 SMALL_LABELS=gcp-rust SMALL_VCPUS=8 SMALL_MAX=4
Environment=GH_ORG=TheDancingDeveloper-org REPOS=codex,vogt,rustnzb,rustTorrent
# GitHub App gha-spot-poller (WI-1863); unset both to fall back to gh_token.
Environment=GH_APP_ID=5372559 GH_APP_INSTALLATION_ID=172817044
Environment=MAX_HOURS_PER_MONTH=250 STATE_FILE=/var/lib/gha-spot-poller/state.json
# Webhook intake (WI-1891), off until the App's webhook, its secret and the
# webhook.caddy route are in place. Then GitHub is listed every 300 s instead of
# every 60 s. Uncomment both lines together: the unit needs the credential file.
#Environment=WEBHOOK_PORT=8095 WEBHOOK_BIND=127.0.0.1
#LoadCredentialEncrypted=gh_webhook_secret:/etc/credstore.encrypted/gha-spot-poller.gh_webhook_secret
# Secrets are TPM2-encrypted at rest and decrypted only into this service's
# private tmpfs credentials directory.
LoadCredentialEncrypted=gh_app_key:/etc/credstore.encrypted/gha-spot-poller.gh_app_key
LoadCredentialEncrypted=gh_token:/etc/credstore.encrypted/gha-spot-poller.gh_token
LoadCredentialEncrypted=gcp_sa_key:/etc/credstore.encrypted/gha-spot-poller.gcp_sa_key
# Monitoring (WI-1892), off until wanted: /metrics, /healthz and /api/v1/* on the
# private network (runner_monitor.py, installed beside the poller). The runner
# inventory needs the read-only App; leave its lines out to serve GCP and job data only.
#Environment=MONITOR_PORT=9468 MONITOR_BIND=127.0.0.1 BUILD_SHA=<commit>
#Environment=RO_GH_APP_ID=<app id> RO_GH_APP_INSTALLATION_ID=<installation id>
#LoadCredentialEncrypted=ro_gh_app_key:/etc/credstore.encrypted/gha-spot-poller.ro_gh_app_key
ExecStart=/usr/bin/python3 /opt/gha-spot-poller/gha_spot_poller.py
Restart=always
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
